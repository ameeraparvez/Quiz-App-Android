<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0D12"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="QUIZ MASTER"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="28dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Test your knowledge. Challenge yourself."
            android:textColor="#8B93A3"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="35dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose a Category"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select a topic and start your quiz"
            android:textColor="#6B7280"
            android:textSize="13sp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="18dp"/>

        <LinearLayout
            android:id="@+id/javaButton"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="@drawable/category_card_background"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="J"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#7C5CFC"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Java"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Programming &amp; OOP"
                    android:textColor="#8B93A3"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

            <TextView
                android:layout_width="52dp"
                android:layout_height="30dp"
                android:text="5 Qs"
                android:textColor="#A78BFA"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#211D35"/>

            <TextView
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#6B7280"
                android:textSize="26sp"
                android:gravity="center"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/htmlButton"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="@drawable/category_card_background"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="&lt;/&gt;"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#2563EB"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HTML &amp; CSS"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Web Structure &amp; Design"
                    android:textColor="#8B93A3"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

            <TextView
                android:layout_width="52dp"
                android:layout_height="30dp"
                android:text="5 Qs"
                android:textColor="#60A5FA"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#17243A"/>

            <TextView
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#6B7280"
                android:textSize="26sp"
                android:gravity="center"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/javascriptButton"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="@drawable/category_card_background"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="JS"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#D97706"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JavaScript"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Web Programming"
                    android:textColor="#8B93A3"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

            <TextView
                android:layout_width="52dp"
                android:layout_height="30dp"
                android:text="5 Qs"
                android:textColor="#FBBF24"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#302716"/>

            <TextView
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#6B7280"
                android:textSize="26sp"
                android:gravity="center"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/sqlButton"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="@drawable/category_card_background"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="DB"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#059669"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SQL &amp; DBMS"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Database &amp; Queries"
                    android:textColor="#8B93A3"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

            <TextView
                android:layout_width="52dp"
                android:layout_height="30dp"
                android:text="5 Qs"
                android:textColor="#34D399"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#132B24"/>

            <TextView
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#6B7280"
                android:textSize="26sp"
                android:gravity="center"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/generalButton"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="@drawable/category_card_background"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="IT"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#DC2626"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Computer Basics"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="General Computer Knowledge"
                    android:textColor="#8B93A3"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

            <TextView
                android:layout_width="52dp"
                android:layout_height="30dp"
                android:text="5 Qs"
                android:textColor="#F87171"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#30191B"/>

            <TextView
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#6B7280"
                android:textSize="26sp"
                android:gravity="center"/>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="5 questions  •  Choose your category  •  Start learning"
            android:textColor="#555D6D"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp"/>

    </LinearLayout>

</ScrollView>