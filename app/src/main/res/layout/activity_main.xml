<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0D12"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="QUIZ MASTER"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="40dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Test your knowledge. Challenge yourself."
            android:textColor="#8B93A3"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="35dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="50 Questions • 5 Categories"
            android:textColor="#7C5CFC"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="25dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose a Category"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select a topic and start your quiz"
            android:textColor="#6B7280"
            android:textSize="13sp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="18dp"/>

        <LinearLayout
            android:id="@+id/javaButton"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="@drawable/category_card_background"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@drawable/ic_java"
                android:scaleType="fitCenter"
                android:contentDescription="Java Icon"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Java"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Programming &amp; OOP"
                    android:textColor="#8B93A3"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

            <TextView
                android:layout_width="52dp"
                android:layout_height="30dp"
                android:text="10 Qs"
                android:textColor="#A78BFA"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#211D35"/>

            <TextView
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#6B7280"
                android:textSize="26sp"
                android:gravity="center"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/htmlButton"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="@drawable/category_card_background"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_html2"
                android:scaleType="fitCenter"
                android:backgroundTint="@color/white"
                android:contentDescription="Java Icon"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HTML &amp; CSS"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Web Structure &amp; Design"
                    android:textColor="#8B93A3"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

            <TextView
                android:layout_width="52dp"
                android:layout_height="30dp"
                android:text="10 Qs"
                android:textColor="#60A5FA"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#17243A"/>

            <TextView
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#6B7280"
                android:textSize="26sp"
                android:gravity="center"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/sqlButton"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/category_card_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="Java Icon"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_sql" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SQL &amp; DBMS"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Database &amp; Queries"
                    android:textColor="#8B93A3"
                    android:textSize="13sp" />

            </LinearLayout>

            <TextView
                android:layout_width="52dp"
                android:layout_height="30dp"
                android:background="#132B24"
                android:gravity="center"
                android:text="10 Qs"
                android:textColor="#34D399"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="›"
                android:textColor="#6B7280"
                android:textSize="26sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/javascriptButton"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="@drawable/category_card_background"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_js2"
                android:scaleType="fitCenter"
                android:contentDescription="Java Icon"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JavaScript"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Web Programming"
                    android:textColor="#8B93A3"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

            <TextView
                android:layout_width="52dp"
                android:layout_height="30dp"
                android:text="10 Qs"
                android:textColor="#FBBF24"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#302716"/>

            <TextView
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#6B7280"
                android:textSize="26sp"
                android:gravity="center"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/generalButton"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="@drawable/category_card_background"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_basics"
                android:scaleType="fitCenter"
                android:contentDescription="Java Icon"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Computer Basics"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="General Computer Knowledge"
                    android:textColor="#8B93A3"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

            <TextView
                android:layout_width="52dp"
                android:layout_height="30dp"
                android:text="10 Qs"
                android:textColor="#F87171"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#30191B"/>

            <TextView
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#6B7280"
                android:textSize="26sp"
                android:gravity="center"/>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="10 questions in each categories • Choose your category  •  Start learning"
            android:textColor="#555D6D"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/achievementsButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="🏆  View Achievements"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:backgroundTint="#292E3A"
            android:layout_marginTop="20dp"/>

    </LinearLayout>

</ScrollView>